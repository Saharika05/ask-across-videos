# Copy this file to .streamlit/secrets.toml and fill in real values.
# secrets.toml is gitignored — never commit real keys.

# Optional: only needed if you want the app to have a default key
# (users can still paste their own key in the sidebar even without this)

# OPENROUTER_API_KEY = "sk-or-v1-..."
# GROQ_API_KEY = "gsk_..."
# GEMINI_API_KEY = "AIzaSy..."
